# Locality Idea Assistant — Environment Variables

# ─── Required ─────────────────────────────────────────────────────────────────
# Your Groq API key — get one free at https://console.groq.com
GROQ_API_KEY=gsk_your-groq-key-here

# ─── Optional ──────────────────────────────────────────────────────────────────
# Groq model to use (defaults to llama-3.3-70b-versatile)
# Options: llama-3.3-70b-versatile | llama-3.1-8b-instant | mixtral-8x7b-32768 | gemma2-9b-it
GROQ_MODEL=llama-3.3-70b-versatile

# Tavily search API key — powers real internet problem search
# Get free key (1000 req/month) at https://tavily.com
TAVILY_API_KEY=tvly-your-tavily-key-here
